# Copie este arquivo para ".env" (mesma pasta) e preencha com os valores
# reais. Nunca é commitado (está no .gitignore) — este ".example" é só o
# modelo, sem nenhum segredo de verdade.
#
# Este ÚNICO .env alimenta as três coisas do projeto:
#   - backend  (server/src/server.js lê ele via dotenv, path absoluto pra raiz)
#   - frontend (client/vite.config.js tem envDir apontando pra raiz)
#   - docker-compose.yml (substitui os ${...} e injeta no container do server)

# --- Servidor ---
PORT=3001

# --- Banco de dados ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ajudaaudio
# Em produção com banco hospedado (Render Postgres, Supabase, Neon...):
# quase sempre exige SSL. Local/docker-compose com Postgres próprio: false.
DB_SSL=false

# --- IA do chat (Zélia) ---
# Só o GROQ_API_KEY é usado hoje pelo código (server/src/routes/chat.js).
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Autenticação ---
# Gere uma string aleatória longa (ex: openssl rand -hex 48). Nunca
# reutilize entre ambientes — se vazar, invalida sessões trocando o valor.
JWT_SECRET=

# --- E-mail transacional (redefinição de senha, confirmação de cadastro) ---
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# --- Endereços da aplicação ---
# URL onde o FRONTEND está publicado — usada tanto pra montar os links
# enviados por e-mail quanto (por padrão) como origem liberada no CORS.
# Local: http://localhost:5173
# Produção: a URL pública real do frontend (ex: https://ajudaaudio.com.br)
FRONTEND_URL=http://localhost:5173
# Opcional: lista de origens liberadas no CORS, separadas por vírgula.
# Só precisa preencher se o front tiver mais de um domínio (ex: com e sem
# "www", ou um domínio de staging além do de produção). Se não definir,
# cai automaticamente no FRONTEND_URL acima.
CORS_ORIGENS=

# --- Frontend (Vite) ---
# URL do backend publicado. Embutida no JS já em build/dev time — troque
# pra URL pública real do backend antes de rodar `npm run build`/`docker
# compose build`.
# Local: http://localhost:3001
# Produção: a URL pública real do backend (ex: https://api.ajudaaudio.com.br)
VITE_API_URL=http://localhost:3001
VITE_GEMINI_API_KEY=
