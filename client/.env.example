# Copie este arquivo para ".env" se quiser sobrescrever o padrão local.
# Sem esse arquivo, o app já cai automaticamente em http://localhost:3001
# (veja client/src/config.js) — então localmente isso é opcional.

# URL do backend publicado. Obrigatório configurar em produção (Render etc.)
# como variável de ambiente do serviço do FRONTEND — variáveis VITE_* são
# embutidas no build, então precisa estar definida ANTES de rodar `npm run build`.
VITE_API_URL=http://localhost:3001
