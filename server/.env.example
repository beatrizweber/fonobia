# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" nunca é commitado (está no .gitignore) — este ".example" é só
# o modelo, sem nenhum segredo de verdade.

# Porta do servidor. Em produção (Render etc.) a plataforma injeta a
# variável PORT automaticamente — pode deixar em branco/3001 que o código
# já usa process.env.PORT quando existir.
PORT=3001

# --- Banco de dados ---
DB_USER=postgres
DB_HOST=localhost
DB_NAME=ajudaaudio
DB_PASSWORD=
DB_PORT=5432
# Em produção, com banco hospedado (Render Postgres, Supabase, Neon...):
# quase sempre exige SSL. Local, deixe em false/vazio.
DB_SSL=false

# --- IA do chat (Zélia) ---
# Só o GROQ_API_KEY é usado hoje pelo código (server/src/routes/chat.js).
GROQ_API_KEY=

# --- Autenticação ---
# Gere uma string aleatória longa (ex: openssl rand -hex 48). Nunca reutilize
# entre ambientes — se vazar, invalida sessões trocando esse valor.
JWT_SECRET=

# --- E-mail transacional (redefinição de senha, confirmação de cadastro) ---
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# --- Endereços da aplicação ---
# URL onde o FRONTEND está publicado — usada tanto pra montar os links
# enviados por e-mail quanto (por padrão) como origem liberada no CORS.
# Local: http://localhost:5173
# Produção: a URL real do frontend publicado (ex: https://ajudaaudio.onrender.com)
FRONTEND_URL=http://localhost:5173

# Opcional: lista de origens liberadas no CORS, separadas por vírgula.
# Só precisa preencher se o front tiver mais de um domínio (ex: com e sem
# "www", ou um domínio de staging além do de produção). Se não definir,
# cai automaticamente no FRONTEND_URL acima.
# CORS_ORIGENS=https://ajudaaudio.com,https://www.ajudaaudio.com
